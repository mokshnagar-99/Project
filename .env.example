# ----------------------------------------
# Groq API Configuration
# ----------------------------------------
# Obtain your free API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------
# Redis Queue Configuration
# ----------------------------------------
# Use REDIS_URL for cloud providers (Railway, Render, Upstash, etc.)
# REDIS_URL=redis://default:password@host:port/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ----------------------------------------
# Worker & Concurrency Controls
# ----------------------------------------
MAX_CONCURRENT_WORKERS=2
# Token budget per minute (Groq free tier has TPM limits)
TOKEN_BUDGET_PER_MIN=60000
# Target output root for generated jobs
GENERATED_DIR=./generated

# ----------------------------------------
# Observability & Metrics
# ----------------------------------------
PROMETHEUS_METRICS_PORT=9090

# ----------------------------------------
# Optional Git Remote Publishing
# ----------------------------------------
# Set these if you want generated code to be pushed to a repository automatically
GIT_AUTO_PUBLISH=false
GIT_HOST=github.com
GIT_USER=your_username
GIT_PAT=ghp_your_personal_access_token_here
GIT_ORG_OR_USER=your_username
